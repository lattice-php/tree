{
    "name": "lattice-php/tree",
    "description": "Tree view component for Lattice — hierarchy rendering from callback or Eloquent adjacency-list sources.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "lattice-php/lattice": "^0.36"
    },
    "require-dev": {
        "bambamboole/extended-testbench": "^0.6",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.16",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Lattice\\Tree\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lattice\\Tree\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "extended-testbench": {
            "check-ignore": [
                "tests/Browser/DummyTest.php",
                "composer script: lint"
            ]
        },
        "lattice": {
            "plugin": "resources/js/plugin.ts",
            "discover": ["src"]
        },
        "laravel": {
            "providers": [
                "Lattice\\Tree\\TreeServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "post-install-cmd": [
            "@boost:refresh"
        ],
        "post-update-cmd": [
            "@boost:refresh"
        ],
        "boost:refresh": "[ -n \"$CI\" ] || [ ! -f vendor/bin/testbench ] || [ ! -f boost.json ] || { [ -f package.json ] && [ ! -d node_modules ]; } || vendor/bin/testbench boost:update --no-interaction || true",
        "serve": "@php vendor/bin/testbench serve",
        "test": "pest --exclude-testsuite=Browser",
        "test:browser": [
            "npm run build",
            "pest --testsuite=Browser"
        ],
        "test:lint": "@php vendor/bin/pint --test",
        "lint": "@php vendor/bin/pint",
        "stan": "phpstan analyse",
        "check": [
            "pint --test",
            "phpstan analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
